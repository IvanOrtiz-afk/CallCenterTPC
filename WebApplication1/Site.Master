<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.master.cs" Inherits="CallCenterTPC.SiteMaster" %>

<!DOCTYPE html>

<html lang="es">
<head runat="server">
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
    <title><%: Page.Title %> - Sistema de gestión de tickets</title>
    
    <link href="~/favicon.ico" rel="shortcut icon" type="image/x-icon" />

    <style>
        .PaginadorBootstrap table {
            margin: 15px auto; 
            border-collapse: separate;
            border-spacing: 0;
        }
        .PaginadorBootstrap table td {
            padding: 0;
            border: none;
        }
        .PaginadorBootstrap table td a, 
        .PaginadorBootstrap table td span {
            display: block;
            padding: 8px 12px;
            margin: 0 2px;
            border: 1px solid #dee2e6; 
            border-radius: 4px; 
            text-decoration: none;
            color: #0d6efd; 
            font-size: 14px;
            transition: all 0.2s ease-in-out;
        }
        .PaginadorBootstrap table td span {
            background-color: #0d6efd; 
            color: white; 
            border-color: #0d6efd;
            cursor: default;
        }
        .PaginadorBootstrap table td a:hover {
            background-color: #e9ecef; 
            color: #0a58ca; 
            border-color: #dee2e6;
        }
    </style>
</head>

<body>
    <form runat="server">

        <asp:ScriptManager runat="server"></asp:ScriptManager>

      <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
          <div class="d-flex align-items-center">
    <asp:Label
        ID="lblUsuario"
        runat="server"
        CssClass="text-white me-3" />

    <asp:Button
        ID="btnSalir"
        runat="server"
        Text="Salir"
        CssClass="btn btn-outline-light btn-sm"
        OnClick="btnSalir_Click" />
</div>
  <div class="container">
    <a class="navbar-brand" runat="server" href="~/Default.aspx">Call Center TPC</a>
    
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>
    
    <div class="collapse navbar-collapse" id="navbarNav">
      <ul class="navbar-nav">
        <li class="nav-item">
            <a class="nav-link" runat="server" href="~/Default.aspx">Inicio</a>
        </li>
        <li id="liClientes" runat="server" class="nav-item">
            <a class="nav-link" runat="server" href="~/Clientes.aspx">Clientes</a>
        </li>
        <li id="liUsuarios" runat="server" class="nav-item">
            <a class="nav-link" runat="server" href="~/Usuarios.aspx">Usuarios</a>
        </li>
        <li id="liIncidencias" runat="server" class="nav-item">
            <a class="nav-link" runat="server" href="~/Incidencias.aspx">Incidencias</a>
        </li>
        <li id="liPrioridades" runat="server" class="nav-item">
            <a class="nav-link" runat="server" href="~/Prioridades.aspx">Prioridades</a>
        </li>
        <li id="liTiposIncidencia" runat="server" class="nav-item">
            <a class="nav-link" runat="server" href="~/TiposIncidencia.aspx">Tipos de Incidencia</a>
        </li>
      </ul>
    </div>
  </div>
</nav>


        <div class="container body-content">

            <asp:ContentPlaceHolder ID="MainContent" runat="server">
            </asp:ContentPlaceHolder>

            <hr />

            <footer>
                <p>
                    &copy; <%: DateTime.Now.Year %> - Trabajo Práctico cuatrimestral Call Center
                </p>
            </footer>

        </div>

    </form>


</body>
</html>
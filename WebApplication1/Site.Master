<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.master.cs" Inherits="CallCenterTPC.SiteMaster" %>

<!DOCTYPE html>

<html lang="es">
<head runat="server">
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title><%: Page.Title %> - Sistema de gestión de tickets</title>

    <style>
    body {
        font-family: Arial, sans-serif;
        margin: 0;
        background-color: #f5f5f5;
    }

    nav {
        background-color: #1e293b;
        padding: 15px;
    }

    nav ul {
        list-style: none;
        margin: 0;
        padding: 0;
    }

    nav li {
        display: inline-block;
        margin-right: 20px;
    }

    nav a {
        color: white;
        text-decoration: none;
        font-weight: bold;
    }

    nav a:hover {
        text-decoration: underline;
    }

    .body-content {
        padding: 20px;
        background-color: white;
        margin: 20px;
        border-radius: 8px;
    }

    h1, h2 {
        color: #1e293b;
    }

    footer {
        margin-top: 30px;
        color: gray;
    }

    table {
        border-collapse: collapse;
        width: 100%;
    }

    th, td {
        border: 1px solid #ccc;
        padding: 8px;
    }

    th {
        background-color: #e5e7eb;
    }
</style>
    

    <link href="~/favicon.ico" rel="shortcut icon" type="image/x-icon" />
</head>

<body>
    <form runat="server">

        <asp:ScriptManager runat="server"></asp:ScriptManager>

        <nav>
    <ul>
        <li><a runat="server" href="~/Default.aspx">Inicio</a></li>
        <li><a runat="server" href="~/Clientes.aspx">Clientes</a></li>
        <li><a runat="server" href="~/Usuarios.aspx">Usuarios</a></li>
        <li><a runat="server" href="~/Incidencias.aspx">Incidencias</a></li>
        <li><a runat="server" href="~/Prioridades.aspx">Prioridades</a></li>
        <li><a runat="server" href="~/TiposIncidencia.aspx">Tipos de Incidencia</a></li>
    </ul>
</nav>

        <div class="container body-content">

            <asp:ContentPlaceHolder ID="MainContent" runat="server">
            </asp:ContentPlaceHolder>

            <hr />

            <footer>
                <p>
                    &copy; <%: DateTime.Now.Year %> - Trabajo Práctico cuatrimestral Call Center
                </p>
            </footer>

        </div>

    </form>


</body>
</html>